generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma/client"
}

datasource db {
  provider = "mysql"
}

model User {
  id           BigInt        @id @default(autoincrement())
  name         String
  userId       String        @unique @map("user_id")
  password     String
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  relation     String
  events       Event[]
  transactions Transaction[]
  galleries    Gallery[]
  notifications      Notification[] @relation("UserNotifications")      // 내가 받은 알림
  actedNotifications Notification[] @relation("UserNotificationActor")  // 내가 발생시킨 알림(옵션)

  @@map("users")
}

model Event {
  id           BigInt          @id @default(autoincrement())
  userId       BigInt          @map("user_id")
  date         DateTime        @default(now())
  location     String?
  message      String?         @db.Text
  category     events_category @default(WEDDING)
  name         String          @default("이벤트")
  eventHosts   EventHost[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("events")
}

model EventHost {
  id           BigInt        @id @default(autoincrement())
  name         String
  role         eventhost_role // 고인인지 상주인지
  eventId      BigInt        @map("events_id")
  accounts     Account[]
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([eventId])
  @@map("eventHost")
}

model Account {
  id           BigInt        @id @default(autoincrement())
  account      String
  bank         String
  eventHostId  BigInt        @map("eventhost_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  eventHost    EventHost     @relation(fields: [eventHostId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([eventHostId])
  @@map("accounts")
}

model Transaction {
  id          BigInt     @id @default(autoincrement())
  userId      BigInt     @map("user_id")
  eventId     BigInt?    @map("events_id")
  eventHostId BigInt?    @map("eventhost_id")
  accountId   BigInt?    @map("accounts_id")
  amount      BigInt
  message     String?    @db.Text
  relation    String
  sentAt      DateTime   @default(now()) @map("sent_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  account     Account?   @relation(fields: [accountId], references: [id])
  eventHost   EventHost? @relation(fields: [eventHostId], references: [id])
  event       Event?     @relation(fields: [eventId], references: [id])
  user        User       @relation(fields: [userId], references: [id])
  notifications Notification[]

  @@index([eventId, sentAt], map: "idx_transactions_events_sent_at")
  @@index([userId, createdAt], map: "idx_transactions_user_created_at")
  @@index([eventHostId], map: "idx_transactions_eventhost_id")
  @@index([accountId], map: "idx_transactions_accounts_id")
  @@map("transactions")
}

model Notification {
  id        BigInt   @id @default(autoincrement())
  type      NotificationType
  text      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // 읽음 처리(알림창 필수 기능)
  readAt    DateTime? @map("read_at")

  // 수신자(알림함 주인)
  receiverId BigInt @map("receiver_id")
  receiver   User   @relation("UserNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  // 누가 발생시켰는지: 송금 보낸 사람, 릴스 올린 사람 등
  actorId   BigInt? @map("actor_id")
  actor     User?   @relation("UserNotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  // “어떤 송금에서 온 알림인지” 연결 (택1로 채워짐)
  transactionId BigInt? @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  // ✅ “구체 대상”만 저장 (릴스/오너먼트/갤러리를 type으로 구분)
  targetId String? @map("target_id")

  @@index([receiverId, createdAt])
  @@index([receiverId, readAt])
  @@index([transactionId])
  @@map("notifications")
}

model Gallery {
  id        BigInt   @id @default(autoincrement())
  key       String   @map("s3_key")
  userId    BigInt   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gallery")
}

// 알림 구분
enum NotificationType {
  GALLERY_ADDED
  REEL_ADDED
  TRANSFER_SENT
  ORNAMENT_ADDED
}


enum events_category {
  WEDDING
  FUNERAL
  BIRTHDAY
}

enum eventhost_role {
  DEAD // 고인
  CHIEF_MOURNER // 대표 상주
  MOURNER // 상주
  GROOM // 신랑
  BRIDE // 신부
  GROOM_FATHER
  GROOM_MOTHER
  BRIDE_FATHER
  BRIDE_MOTHER
}