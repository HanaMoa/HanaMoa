
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}
model User {
  id        BigInt   @id @default(autoincrement())
  name      String
  userId    String   @unique @map("user_id")
  password  String
  relation String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  events        Event[]
  transactions  Transaction[]

  @@map("users")
}

model Event {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  date      DateTime @default(now())
  location  String
  message   String?  @db.Text

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  eventHosts EventHost[]
  transactions Transaction[]

  @@map("events")
  @@index([userId])
}

model EventHost {
  id       BigInt @id @default(autoincrement())
  name     String

  eventId  BigInt @map("events_id")
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  accounts      Account[]
  transactions  Transaction[]

  @@map("eventHost")
  @@index([eventId])
}

model Account {
  id         BigInt   @id @default(autoincrement())
  account    String
  bank       String

  eventHostId BigInt  @map("eventhost_id")
  eventHost   EventHost @relation(fields: [eventHostId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("accounts")
  @@index([eventHostId])
}

model Transaction {
  id BigInt @id @default(autoincrement())

  // 거래가 있는 유저는 삭제 불가(RESTRICT) + NOT NULL 유지
  userId BigInt @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // 이벤트/호스트/계좌는 삭제될 수 있으므로 NULL 허용 + SET NULL
  eventId     BigInt? @map("events_id")
  event       Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  eventHostId BigInt? @map("eventhost_id")
  eventHost   EventHost? @relation(fields: [eventHostId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  accountId   BigInt? @map("accounts_id")
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  amount   BigInt
  message  String?  @db.Text
  relation String

  sentAt   DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("transactions")
  @@index([eventId, sentAt], map: "idx_transactions_events_sent_at")
  @@index([userId, createdAt], map: "idx_transactions_user_created_at")
  @@index([eventHostId], map: "idx_transactions_eventhost_id")
  @@index([accountId], map: "idx_transactions_accounts_id")
}
