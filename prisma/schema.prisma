generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma/client"
}

datasource db {
  provider = "mysql"
}

model User {
  id                 BigInt         @id @default(autoincrement())
  name               String
  userId             String         @unique @map("user_id")
  password           String
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  relation           String
  events             Event[]
  galleries          Gallery[]
  actedNotifications Notification[] @relation("UserNotificationActor")
  notifications      Notification[] @relation("UserNotifications")
  transactions       Transaction[]

  @@map("users")
}

model Event {
  id           BigInt          @id @default(autoincrement())
  userId       BigInt          @map("user_id")
  date         DateTime        @default(now())
  location     String?
  message      String?         @db.Text
  category     events_category @default(WEDDING)
  name         String?
  eventHosts   EventHost[]
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  galleries    Gallery[]
  transactions Transaction[]

  @@index([userId])
  @@map("events")
}

model EventHost {
  id           BigInt         @id @default(autoincrement())
  name         String
  role         eventhost_role
  eventId      BigInt         @map("events_id")
  accounts     Account[]
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([eventId, name], name: "uniq_eventhost_event_name")
  @@index([eventId])
  @@map("eventHost")
}

model Account {
  id           BigInt        @id @default(autoincrement())
  account      String
  bank         String
  eventHostId  BigInt        @map("eventhost_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  eventHost    EventHost     @relation(fields: [eventHostId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([eventHostId, bank, account], name: "uniq_account_host_bank_account") 
  @@index([eventHostId])
  @@map("accounts")
}

model Transaction {
  id            BigInt         @id @default(autoincrement())
  userId        BigInt         @map("user_id")
  eventId       BigInt?        @map("events_id")
  eventHostId   BigInt?        @map("eventhost_id")
  accountId     BigInt?        @map("accounts_id")
  amount        BigInt
  message       String?        @db.Text
  relation      String
  sentAt        DateTime       @default(now()) @map("sent_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  name          String?        @map("ocr_name")
  notifications Notification[]
  account       Account?       @relation(fields: [accountId], references: [id])
  eventHost     EventHost?     @relation(fields: [eventHostId], references: [id])
  event         Event?         @relation(fields: [eventId], references: [id])
  user          User           @relation(fields: [userId], references: [id])

  @@index([eventId, sentAt], map: "idx_transactions_events_sent_at")
  @@index([userId, createdAt], map: "idx_transactions_user_created_at")
  @@index([eventHostId], map: "idx_transactions_eventhost_id")
  @@index([accountId], map: "idx_transactions_accounts_id")
  @@map("transactions")
}

model Notification {
  id            BigInt           @id @default(autoincrement())
  type          NotificationType
  text          String           @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")
  readAt        DateTime?        @map("read_at")
  receiverId    BigInt           @map("receiver_id")
  actorId       BigInt?          @map("actor_id")
  transactionId BigInt?          @map("transaction_id")
  targetId      String?          @map("target_id")
  actor         User?            @relation("UserNotificationActor", fields: [actorId], references: [id])
  receiver      User             @relation("UserNotifications", fields: [receiverId], references: [id], onDelete: Cascade)
  transaction   Transaction?     @relation(fields: [transactionId], references: [id])

  @@index([receiverId, createdAt])
  @@index([receiverId, readAt])
  @@index([transactionId])
  @@index([actorId], map: "notifications_actor_id_fkey")
  @@map("notifications")
}

enum NotificationType {
  GALLERY_ADDED
  REEL_ADDED
  TRANSFER_SENT
  ORNAMENT_ADDED
}

model Gallery {
  id         BigInt            @id @default(autoincrement())
  key        String            @map("s3_key") 
  userId     BigInt            @map("user_id")
  createdAt  DateTime          @default(now()) @map("created_at")
  eventId    BigInt            @map("event_id")
  visibility GalleryVisibility @default(PRIVATE)
  type       NotificationType
  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([eventId])
  @@index([visibility])
  @@map("gallery")
}



enum events_category {
  WEDDING
  FUNERAL
  BIRTHDAY
}

enum eventhost_role {
  DEAD
  CHIEF_MOURNER
  MOURNER
  GROOM
  BRIDE
  GROOM_FATHER
  GROOM_MOTHER
  BRIDE_FATHER
  BRIDE_MOTHER
}

enum GalleryVisibility {
  PRIVATE
  PUBLIC
}
